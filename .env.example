# ─────────────────────────────────────────────────────────────
# dscrd-status — environment configuration
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# (Required) Your Discord user token.
# See the README for step-by-step instructions on how to obtain it.
DISCORD_TOKEN=your_user_token_here

# (Optional) Online status to maintain.
# Accepted values: online | idle | dnd | invisible
# Default: online
#DISCORD_STATUS=online

# (Optional) Enable verbose / debug logging.
# Set to "true" or "1" to enable.
# Default: false (off)
#DISCORD_VERBOSE=false
