# ─────────────────────────────────────────────────────────────
# dscrd-status — environment configuration
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# (Required) Your Discord user token.
# See the README for step-by-step instructions on how to obtain it.
DISCORD_TOKEN=your_user_token_here

# (Optional) Online status to maintain.
# Accepted values: online | idle | dnd | invisible
# Default: online
#DISCORD_STATUS=online

# (Optional) Enable verbose / debug logging.
# Set to "true" or "1" to enable.
# Default: false (off)
#DISCORD_VERBOSE=false

# (Optional) Active time window.
# Set both values to make the daemon stay connected only during this daily window.
# Format: 24-hour HH:MM or HH:MM:SS
# Examples:
#DISCORD_ACTIVE_START=09:00
#DISCORD_ACTIVE_END=18:00
#
# Overnight windows are supported, for example:
#DISCORD_ACTIVE_START=22:00
#DISCORD_ACTIVE_END=06:30

# (Optional) IANA timezone used for the active window.
# Default: UTC when a time window is set and no timezone is provided.
# Example values:
#DISCORD_TIMEZONE=America/Chicago
#DISCORD_TIMEZONE=Asia/Taipei
